[Unit]
Description=PR Agent Bitbucket Polling Service
After=network.target

[Service]
Type=simple
User=pr-agent
Group=pr-agent
WorkingDirectory=/opt/pr-agent
Environment="PATH=/opt/pr-agent/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/pr-agent/venv/bin/python -m pr_agent.servers.bitbucket_server_polling
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pr-agent-polling

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pr-agent /var/log/pr-agent

[Install]
WantedBy=multi-user.target
