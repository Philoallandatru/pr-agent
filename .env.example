# JWT Configuration
JWT_SECRET_KEY=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Bitbucket Server Configuration
BITBUCKET_SERVER_URL=https://bitbucket.example.com
BITBUCKET_BEARER_TOKEN=your-bitbucket-token

# OpenAI Configuration (if using OpenAI models)
OPENAI_API_KEY=your-openai-api-key

# Database Configuration
DATABASE_PATH=/data/db/pr_agent.db

# Tokenizer Cache
TOKENIZER_CACHE_DIR=/data/tokenizers

# Repository Cache
REPO_CACHE_DIR=/data/repos

# Polling State
POLLING_STATE_FILE=/data/state/polling_state.json
