# Copy this file to .env before running docker compose.
# Do not commit .env. It is already ignored by .gitignore.

# Bitbucket Server / Data Center
CONFIG__GIT_PROVIDER=bitbucket_server
BITBUCKET_SERVER__URL=https://bitbucket.example.com
BITBUCKET_SERVER__BEARER_TOKEN=replace-with-bitbucket-personal-access-token

# Local or intranet OpenAI-compatible model endpoint.
# Examples:
#   vLLM:       http://127.0.0.1:8000/v1
#   llama.cpp:  http://127.0.0.1:8080/v1
#   LM Studio:  http://127.0.0.1:1234/v1
#   Ollama OpenAI-compatible endpoint: http://127.0.0.1:11434/v1
CONFIG__MODEL=openai/local-review-model
CONFIG__FALLBACK_MODELS=[]
CONFIG__CUSTOM_MODEL_MAX_TOKENS=32768
OPENAI__API_BASE=http://host.docker.internal:8000/v1
OPENAI__KEY=local-api-key
OPENAI_API_KEY=local-api-key

# Strict local tokenizer/cache mode.
# The service must use this cache or fail; it should not download tokenizer/model
# assets from Hugging Face or other public networks during normal operation.
TOKENIZER__LOCAL_CACHE_DIR=/data/tokenizers
TOKENIZER__ENABLE_LOCAL_CACHE=true
TOKENIZER__FALLBACK_TO_DOWNLOAD=false
TIKTOKEN_CACHE_DIR=/data/tokenizers

# Runtime paths inside the container.
BITBUCKET_SERVER__POLLING_STATE_FILE=/data/state/polling_state.json
BITBUCKET_SERVER__POLLING_REVIEW_TIMEOUT_SECONDS=1800
REPO_CONTEXT__CLONE_CACHE_DIR=/data/repos
